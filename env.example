# env.example — copy 做 .env 再填值(叫 Claude Code 幫你做 + 確保 .gitignore 包住 .env)
# ⚠️ 鐵律:呢個檔嘅內容只可以存在於 (1) 本機 .env (2) GitHub Secrets。唔入 code、唔貼上網、唔 set 落全域 shell。

# ===== 模型路由 —— 試跑階段(零 API 成本,行你個 Claude Max plan)=====
SCOUT_PROVIDER=claude_code
SCOUT_MODEL=haiku
MASTER_PROVIDER=claude_code
MASTER_MODEL=sonnet

# ===== 模型路由 —— Production 切換(試跑通咗、決定上 production 先解開)=====
# SCOUT_PROVIDER=minimax
# SCOUT_MODEL=MiniMax-M3
# MASTER_PROVIDER=anthropic
# MASTER_MODEL=claude-sonnet-4-6

# ===== MiniMax(production scout 腦;platform.minimax.io 攞 PAYG key)=====
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic   # 確實路徑以 platform.minimax.io docs 為準

# ===== Anthropic API(production master 腦;platform.claude.com/settings/keys)=====
# ⚠️ 只放呢度。全域 shell set 咗會搶你 Claude Code 嘅訂閱認證,vibe code 變扣 API 數。
# ANTHROPIC_API_KEY=

# ===== 收料(Phase 1B)=====
REDDIT_USER_AGENT=flight-deal-scout/1.0 by u/yourname

# ===== Telegram 推送(Phase 2.2;@BotFather 攞 token)=====
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=          # @userinfobot 攞你個人 ID(用前要先入 bot 撳一次 START)
TELEGRAM_CHANNEL_ID=             # 公開 channel @username;冇就留空(淨係 push 畀 owner)

# ===== Database(Phase 2.5;supabase.com → Project Settings → Data API)=====
# SUPABASE_URL=                  # 形如 https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_...(前端可見)
# SUPABASE_SECRET_KEY=           # sb_secret_...  ⚠️ 死都唔入前端 / NEXT_PUBLIC_

# ===== Optional 後備(之後先填)=====
# SERPAPI_KEY=
# APIFY_TOKEN=
